{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "artifacts/*",
    "lib/*",
    "scripts"
  ],
  "scripts": {
    "build:frontend": "npm run build --workspace=@workspace/portasplit-alerts",
    "build:backend": "npm run build --workspace=@workspace/api-server",
    "build": "npm run build:frontend && npm run build:backend",
    "dev": "npm run build:frontend && npm run dev --workspace=@workspace/api-server",
    "typecheck:libs": "tsc --build",
    "typecheck": "npm run typecheck:libs"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
